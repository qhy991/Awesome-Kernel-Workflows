{
  "schema_version": 1,
  "backend_id": "rocm",
  "display_name": "AMD ROCm / HIP (hipcc)",
  "source_ext": ".cu",
  "aux_ext": [".cuh", ".h", ".hpp", ".hip"],
  "artifact_ext": ".so",
  "hw_vendor": "amd",
  "threshold_profile": "amd_rdna",
  "compiler": { "name": "hipcc", "invoke": "build.sh" },
  "runner": { "invoke": "run.sh" },
  "profiler": {
    "name": "rocprofv3",
    "invoke": "profile.sh",
    "format": "rocprof-csv",
    "to_evidence": "to_evidence.py"
  },
  "capabilities": {
    "metrics": { "latency_ms": true, "dram_pct": true, "sm_pct": true, "occupancy": true },
    "bottleneck_classes": ["memory_bound", "compute_bound", "latency_occupancy", "overhead_bound"],
    "problem_types": ["kernel-optimization", "kernel-generation", "in-codebase-kernel-optimization"],
    "precisions": ["fp32", "fp16", "bf16"]
  },
  "requires_tools": ["hipcc"],
  "optional_tools": ["rocprofv3", "rocprof", "llvm-objdump"],
  "idioms": "idioms.json",
  "status": "experimental",
  "notes": "Supports --build-cmd template for in-codebase kernels (cmake, ninja, etc.). When no rocprof tool is present, profile.sh degrades to a latency-only path. RDNA 3.5 APU (gfx1151) and CDNA share the same canonical metric surface; threshold_profile differentiates them."
}
