{
  "schema_version": 1,
  "backend_id": "xpu",
  "display_name": "Intel XPU (SYCL / Triton-XPU, icpx)",
  "source_ext": ".cpp",
  "aux_ext": [".h", ".hpp", ".sycl"],
  "artifact_ext": ".so",
  "hw_vendor": "intel",
  "threshold_profile": "intel",
  "compiler": { "name": "icpx", "invoke": "build.sh" },
  "runner": { "invoke": "run.sh" },
  "profiler": {
    "name": "vtune",
    "invoke": "profile.sh",
    "format": "vtune-csv",
    "to_evidence": "to_evidence.py"
  },
  "capabilities": {
    "metrics": { "latency_ms": true, "dram_pct": true, "sm_pct": false, "occupancy": false },
    "bottleneck_classes": ["memory_bound", "compute_bound", "latency_occupancy", "overhead_bound"],
    "problem_types": ["kernel-optimization", "kernel-generation"],
    "precisions": ["fp32", "fp16", "bf16"]
  },
  "requires_tools": ["icpx", "python3"],
  "optional_tools": ["vtune"],
  "idioms": "idioms.json",
  "status": "experimental",
  "_note": "Minimal manifest so the profiling-strategist can resolve XPU -> VTune (native, latency+dram) with perf_heuristic fallback when vtune is absent. Profiler driver scripts (profile.sh/to_evidence.py) not yet provided; Xe-Forge uses VTune directly."
}
